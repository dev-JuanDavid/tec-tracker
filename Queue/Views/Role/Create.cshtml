@model Queue.Models.RoleViewModel
@{
    ViewBag.Title = Model != null && !string.IsNullOrWhiteSpace(Model.Id) ? "Editar rol" : "Nuevo rol";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.Partial("~/Views/Shared/Components/Forms/_RoleForm.cshtml", Model, new ViewDataDictionary(ViewData))

