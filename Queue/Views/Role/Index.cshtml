@model IEnumerable<Queue.Models.RoleViewModel>
@using Queue.Models
@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Roles";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var table = TableComponent.From(Model ?? Enumerable.Empty<RoleViewModel>(),
        new TableColumn<RoleViewModel> { Title = "Nombre", Cell = role => TableCell.Text(role.Name) },
        new TableColumn<RoleViewModel> { Title = "Editar", Cell = role => TableCell.Link("Editar", Url.Action("Edit", "Role", new { id = role.Id })) },
        new TableColumn<RoleViewModel> { Title = "Detalle", Cell = role => TableCell.Link("Ver detalle", Url.Action("Details", "Role", new { id = role.Id })) },
        new TableColumn<RoleViewModel> { Title = "Eliminar", Cell = role => TableCell.Link("Eliminar", Url.Action("Delete", "Role", new { id = role.Id })) });
    table.Title = "Roles";
    table.Description = "Consulta y administra los roles del sistema.";
    table.CreateUrl = Url.Action("Create", "Role");
    table.CreateLabel = "Nuevo rol";
}
@Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)

