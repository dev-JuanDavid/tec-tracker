@model Queue.Models.RoleViewModel
@using Queue.Models.Components
@{
    ViewBag.Title = "Eliminar rol";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var form = new FormComponent {
        Title = "Eliminar rol", Description = "Confirma la eliminación del rol «" + Model.Name + "».",
        ActionUrl = Url.Action("DeleteConfirmed", "Role"), CancelUrl = Url.Action("Index", "Role"), SubmitLabel = "Eliminar rol",
        Inputs = new System.Collections.Generic.List<IFormInput> { new HiddenInput { Name = "Id", Value = Model.Id } }
    };
}
@Html.Partial("~/Views/Shared/Components/Forms/_Form.cshtml", form, new ViewDataDictionary(ViewData))

