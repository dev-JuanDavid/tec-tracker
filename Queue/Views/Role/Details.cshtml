@model Queue.Models.RoleViewModel
@using Queue.Models.Components
@{
    ViewBag.Title = "Detalle del rol";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var detail = new DetailComponent {
        Title = "Detalle del rol",
        Fields = new System.Collections.Generic.List<DetailField> { new DetailField { Label = "Nombre", Value = Model.Name } },
        Actions = new System.Collections.Generic.List<TableCell> {
            TableCell.Link("Volver a roles", Url.Action("Index", "Role")),
            TableCell.Link("Editar", Url.Action("Edit", "Role", new { id = Model.Id }))
        }
    };
}
@Html.Partial("~/Views/Shared/Components/Details/_Details.cshtml", detail)

