@model Queue.Models.IndexViewModel
@using Queue.Models.Components
@{
    ViewBag.Title = "Mi cuenta";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var detail = new DetailComponent {
        Title = "Mi cuenta", Description = "Consulta tu información y administra tu contraseña.",
        Fields = new System.Collections.Generic.List<DetailField> {
            new DetailField { Label = "Nombre", Value = Convert.ToString(Session["Name"]) },
            new DetailField { Label = "Correo electrónico", Value = User.Identity.Name },
            new DetailField { Label = "Rol", Value = Queue.AccessPolicy.IsSuper(User) ? "Super administrador" : User.IsInRole("Admin") ? "Administrador" : User.IsInRole("Employer") ? "Responsable de empresa" : "Usuario" }
        },
        Actions = new System.Collections.Generic.List<TableCell> {
            TableCell.Link(Model.HasPassword ? "Cambiar contraseña" : "Establecer contraseña", Url.Action(Model.HasPassword ? "ChangePassword" : "SetPassword"))
        }
    };
}
@if (!string.IsNullOrWhiteSpace(Convert.ToString(ViewBag.StatusMessage))) {
    <p role="status" class="mb-4 rounded-xl bg-emerald-50 p-4 text-sm text-emerald-800">@ViewBag.StatusMessage</p>
}
@Html.Partial("~/Views/Shared/Components/Details/_Details.cshtml", detail)
