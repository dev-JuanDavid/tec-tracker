@model IEnumerable<Queue.ViewModels.UserListViewModel>
@using Queue.Models.Components
@using Queue.ViewModels
@using System.Linq
@{
    ViewBag.Title = "Usuarios";
    ViewBag.NavTitle = "Usuarios";
    var table = TableComponent.From(Model ?? Enumerable.Empty<UserListViewModel>(),
        new TableColumn<UserListViewModel> { Title = "Correo electrónico", Cell = user => TableCell.Text(user.Email) },
        new TableColumn<UserListViewModel> { Title = "Nombre", Cell = user => TableCell.Text(user.FirstName) },
        new TableColumn<UserListViewModel> { Title = "Sesión", Cell = user => TableCell.Badge(user.IsLoged ? "Conectado" : "Desconectado", user.IsLoged) },
        new TableColumn<UserListViewModel> { Title = "Rol", Cell = user => TableCell.Text(user.Role == "SAdmin" ? "Superadministrador" : user.Role == "Admin" ? "Administrador" : user.Role == "Manager" ? "Responsable" : user.Role) },
        new TableColumn<UserListViewModel> { Title = "Acciones", Cell = user => TableCell.Link("Editar", Url.Action("EditUser", "Manage", new { id = user.Id })) });
    table.Id = "userTable";
    table.Title = "Usuarios";
    table.Description = "Administra los accesos y roles de los usuarios de tu empresa.";
    table.CreateUrl = Url.Action("Register", "Account");
    table.CreateLabel = "Nuevo usuario";
    table.EmptyMessage = "Todavía no hay usuarios asociados a esta empresa.";
}
@Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)
