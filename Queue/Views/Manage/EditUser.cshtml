@model Queue.Models.RegisterViewModel
@{
    var editing = Model != null && !string.IsNullOrWhiteSpace(Model.UserId);
    ViewBag.Title = editing ? "Editar usuario" : "Nuevo usuario";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = Request.IsAjaxRequest() ? null : "~/Views/Shared/_Layout.cshtml";
}
@Html.Partial("~/Views/Shared/Components/Forms/_UserForm.cshtml", Model, new ViewDataDictionary(ViewData))

