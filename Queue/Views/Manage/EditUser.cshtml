@model Queue.Models.RegisterViewModel
@{
    Layout = null; // no cargamos el layout dentro del modal
}

@using (Html.BeginForm("EditUser", "Manage", FormMethod.Post, new { id = "frm_register" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.UserId)

    <div id="divblock" class="max-w-4xl mx-auto bg-white p-6 rounded-2xl shadow-md">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">Edit User</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- FirstName -->
            <div>
                @Html.LabelFor(model => model.FirstName, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" } })
                @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-sm text-red-500 mt-1" })
            </div>

            <!-- LastName -->
            <div>
                @Html.LabelFor(model => model.LastName, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" } })
                @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-sm text-red-500 mt-1" })
            </div>

            <!-- Email -->
            <div>
                @Html.LabelFor(model => model.Email, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" } })
                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-sm text-red-500 mt-1" })
            </div>

            <!-- Role -->
            <div>
                @Html.LabelFor(model => model.Role, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                @Html.DropDownList("RoleID", null, htmlAttributes: new { @class = "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" })
                @Html.ValidationMessageFor(model => model.Role.Id, "", new { @class = "text-sm text-red-500 mt-1" })
            </div>

            <!-- Password -->
            <div>
                @Html.LabelFor(model => model.Password, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" } })
                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-sm text-red-500 mt-1" })
            </div>

            <!-- Confirm Password -->
            <div>
                @Html.LabelFor(model => model.ConfirmPassword, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                @Html.EditorFor(model => model.ConfirmPassword, new { htmlAttributes = new { @class = "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" } })
                @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-sm text-red-500 mt-1" })
            </div>
        </div>

        <!-- Actions -->
        <div class="flex justify-end space-x-4 mt-8">
            <a href="@Url.Action("UserList", "Manage")"
               class="px-6 py-2 rounded-lg bg-gray-300 text-gray-800 hover:bg-gray-400 transition">
                Cancel
            </a>
            <button id="add_user" name="add_user" type="submit" onclick="block('#divblock')"
                    value="Edit"
                    class="px-6 py-2 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-700 transition">
                Edit
            </button>
        </div>
    </div>
}
