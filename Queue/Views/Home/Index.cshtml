@model Queue.Models.DashBoardStats
@{ ViewBag.Title = "Home Page"; }
@{
    var listUsuarios = new List<object>() { new { Usuario = "Seleccione", Nombre = "" } };
    var userList = ViewData["UserList"] == null ? new SelectList(listUsuarios, "Usuario", "Nombre") : ViewData["UserList"];
    // Recuperar filtros seleccionados
    var selectedGroup = Request["idgroup"];
    var selectedUser = Request["user"];
}

<!-- Tailwind -->
<script src="https://cdn.tailwindcss.com"></script>

<!-- FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<!-- Google Charts -->
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>

<!-- jQuery -->
<script src="~/Scripts/jquery-3.4.1.min.js"></script>

<div class="w-full gap-6" id="dashboard">
    <div class="rounded-2xl p-6 gap-6">
        @using (Html.BeginForm("Index", "Home", FormMethod.Post, new { id = "frm_register" }))
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Fecha Desde -->
                <div class="flex-grow min-w-[180px]">
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        @Html.DisplayNameFor(model => model.DateFrom)
                    </label>
                    @Html.TextBoxFor(model => model.DateFrom, new
                    {
                        @class = "w-full py-2 px-4 border border-gray-300 rounded-lg bg-white text-gray-700 hover:border-blue-500 transition duration-200 text-sm shadow-sm",
                        type = "date"
                    })
                </div>

                <!-- Fecha Hasta -->
                <div class="flex-grow min-w-[180px]">
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        @Html.DisplayNameFor(model => model.DateTo)
                    </label>
                    @Html.TextBoxFor(model => model.DateTo, new
                    {
                        @class = "w-full py-2 px-4 border border-gray-300 rounded-lg bg-white text-gray-700 hover:border-blue-500 transition duration-200 text-sm shadow-sm",
                        type = "date"
                    })
                </div>

                <!-- Grupos -->
                <div class="flex-grow min-w-[140px]">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Grupos</label>
                    <div class="relative w-full">
                        @Html.DropDownList("idgroup", ViewBag.idgroup as SelectList, "Seleccione Grupo",
                            new { @class = "w-full py-2 px-4 border border-gray-300 rounded-lg bg-white text-gray-700 hover:border-blue-500 transition duration-200 text-sm shadow-sm" })
                    </div>
                </div>

                <!-- Empleados -->
                <div class="flex-grow min-w-[140px]">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Empleados</label>
                    <div class="relative w-full">
                        @Html.DropDownList("ddlUsers", userList as SelectList, "Todos",
                            new { @class = "w-full py-2 px-4 border border-gray-300 rounded-lg bg-white text-gray-700 hover:border-blue-500 transition duration-200 text-sm shadow-sm", id = "listUsers" })
                    </div>
                </div>
            </div>

            <!-- Botones -->
            <div class="flex justify-end mt-6 space-x-4">
                <button id="add_Employee" type="submit"
                        class="w-full md:w-auto py-2 px-6 bg-white text-gray-700 font-semibold rounded-lg shadow-sm hover:border-blue-500 border border-gray-300 transition duration-200 text-sm flex items-center justify-center">
                    <i class="fa-solid fa-circle-play mr-2"></i>
                    Filtrar
                </button>
                <button id="create_pdf" type="button"
                        class="w-full md:w-auto py-2 px-6 bg-white text-gray-700 font-semibold rounded-lg shadow-sm hover:border-red-500 border border-gray-300 transition duration-200 text-sm flex items-center justify-center">
                    <i class="fa-solid fa-file-pdf text-lg mr-2 text-red-600"></i>
                    Generar PDF
                </button>
            </div>
        }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mt-6">
        <!-- KPI -->
        <div class="md:col-span-1 space-y-6">
            <div class="bg-white border rounded-lg p-4 flex items-center justify-between min-h-40">
                <div>
                    <h3 class="text-sm text-gray-500">Productivo</h3>
                    <p class="text-2xl font-bold">@Model.resume.ProductiveTime %</p>
                </div>
                <i class="fa-solid fa-gauge-high text-green-500 text-4xl"></i>
            </div>

            <div class="bg-white border rounded-lg p-4 flex items-center justify-between min-h-40">
                <div>
                    <h3 class="text-sm text-gray-500">Improductivo</h3>
                    <p class="text-2xl font-bold">@Model.resume.ImproductiveTime %</p>
                </div>
                <i class="fa-solid fa-circle-xmark text-red-500 text-4xl"></i>
            </div>

            <div class="bg-white border rounded-lg p-4 flex items-center justify-between min-h-40">
                <div>
                    <h3 class="text-sm text-gray-500">Neutral</h3>
                    <p class="text-2xl font-bold">@Model.resume.NeutralTime %</p>
                </div>
                <i class="fa-solid fa-circle text-gray-500 text-4xl"></i>
            </div>

            <div class="bg-white border rounded-lg p-4 flex items-center justify-between min-h-40">
                <div>
                    <h3 class="text-sm text-gray-500">Sin Clasificar</h3>
                    <p class="text-2xl font-bold">@Model.resume.UnclasifyTime %</p>
                </div>
                <i class="fa-solid fa-circle-question text-yellow-500 text-4xl"></i>
            </div>
        </div>

        <!-- Gráfica y Tarjetas de Usuarios -->
        <div class="md:col-span-3 space-y-6">
            <div class="bg-white shadow rounded-lg p-6">
                <h2 class="text-lg font-semibold mb-4">Aplicaciones más usadas</h2>
                <div id="chart_wrap">
                    <div id="columnchart_values" class="w-full h-96"></div>
                </div>
            </div>

            <!-- Tarjetas de Usuarios -->
            <div class="bg-white shadow rounded-lg p-6">
                <h2 class="text-lg font-semibold mb-4">Detalle por usuario</h2>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    @foreach (var item in Model.DataPerUser.OrderByDescending(u => u.TotalHours))
                    {
                        string circleColor = "bg-gray-500"; // Default
                        if (item.ProductiveTime >= item.ImproductiveTime && item.ProductiveTime >= item.NeutralTime && item.ProductiveTime >= item.UnclasifyTime)
                        {
                            circleColor = "bg-green-500";
                        }
                        else if (item.ImproductiveTime >= item.ProductiveTime && item.ImproductiveTime >= item.NeutralTime && item.ImproductiveTime >= item.UnclasifyTime)
                        {
                            circleColor = "bg-red-500";
                        }
                        else if (item.NeutralTime >= item.ProductiveTime && item.NeutralTime >= item.ImproductiveTime && item.NeutralTime >= item.UnclasifyTime)
                        {
                            circleColor = "bg-gray-400";
                        }
                        else if (item.UnclasifyTime >= item.ProductiveTime && item.UnclasifyTime >= item.ImproductiveTime && item.UnclasifyTime >= item.NeutralTime)
                        {
                            circleColor = "bg-yellow-500";
                        }

                        <div class="bg-gray-50 rounded-xl shadow p-4 border hover:shadow-lg transition duration-200 flex flex-col justify-between">
                            <!-- Encabezado con circulito y nombre -->
                            <div class="flex items-center mb-3">
                                <span class="w-3 h-3 rounded-full mr-2 @circleColor"></span>
                                <h3 class="text-lg font-semibold text-gray-800">@item.User</h3>
                            </div>

                            <!-- Total Horas -->
                            <p class="text-sm text-gray-600 mb-3">
                                <span class="font-semibold text-blue-600">Total:</span>
                                @FormatTime(item.TotalHours)
                            </p>

                            <!-- Métricas -->
                            <div class="space-y-1 text-sm">
                                <p class="flex justify-between">
                                    <span class="font-semibold text-green-600">Productivas:</span>
                                    <span>@FormatTime(item.ProductiveTime)</span>
                                </p>
                                <p class="flex justify-between">
                                    <span class="font-semibold text-red-600">Improductivas:</span>
                                    <span>@FormatTime(item.ImproductiveTime)</span>
                                </p>
                                <p class="flex justify-between">
                                    <span class="font-semibold text-gray-600">Neutrales:</span>
                                    <span>@FormatTime(item.NeutralTime)</span>
                                </p>
                                <p class="flex justify-between">
                                    <span class="font-semibold text-yellow-600">No Clasificadas:</span>
                                    <span>@FormatTime(item.UnclasifyTime)</span>
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    google.charts.load("current", { packages: ['corechart'] });
    google.charts.setOnLoadCallback(drawChartApp);

    function drawChartApp() {
        var data = new google.visualization.DataTable();
        data.addColumn('string', 'Aplicación');
        data.addColumn('number', 'Porcentaje de Uso');
        data.addColumn({ type: 'string', role: 'style' });

        var datArrary = [];
        var data_ = @Html.Raw(Json.Encode(Model.graph));
        $.each(data_, function (index, value) {
            datArrary.push([value.element, value.decimalvalue, value.color]);
        });
        data.addRows(datArrary);

        var options = {
            title: "5 aplicaciones más usadas",
            titleTextStyle: { color: "black", fontName: "Nunito Sans", fontSize: 20 },
            width: "100%",
            height: 400,
            bar: { groupWidth: "70%" },
            legend: { position: "none" }
        };

        var chart = new google.visualization.BarChart(document.getElementById("columnchart_values"));
        chart.draw(data, options);
    }

    const groupSelect = document.getElementById("idgroup");
    const userSelect = document.getElementById("listUsers");
    let cachedGroups = {};

    groupSelect.addEventListener("change", function () {
        loadUsers(this.value, "");
    });

    function loadUsers(idEmployeeGroup, selectedUser) {
        if (!idEmployeeGroup) {
            userSelect.innerHTML = "<option value='' selected>Seleccione</option>";
            return;
        }

        if (cachedGroups[idEmployeeGroup]) {
            fillUsers(cachedGroups[idEmployeeGroup], selectedUser);
            return;
        }

        fetch("@Url.Action("GetUserByArea", "Operation")", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
            },
            body: JSON.stringify({ idGroupEmployee: idEmployeeGroup })
        })
        .then(response => response.json())
        .then(data => {
            cachedGroups[idEmployeeGroup] = data;
            fillUsers(data, selectedUser);
        })
        .catch(error => console.error("Error al cargar usuarios:", error));
    }

    function fillUsers(data, selectedUser) {
        userSelect.innerHTML = "<option value='' selected>Seleccione</option>";
        data.forEach(user => {
            const option = document.createElement("option");
            option.value = user.Value;
            option.textContent = user.Text;
            if (selectedUser && selectedUser === user.Value) {
                option.selected = true;
            }
            userSelect.appendChild(option);
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        const selectedGroup = "@selectedGroup";
        const selectedUser = "@selectedUser";

        if (selectedGroup && selectedGroup !== "") {
            groupSelect.value = selectedGroup;
            loadUsers(selectedGroup, selectedUser);
        }
    })
</script>

@functions {
    string FormatTime(double time)
    {
        TimeSpan t = TimeSpan.FromHours(time);
        if (t.TotalDays >= 1) return string.Format("{0}d {1}h {2}m {3}s", (int)t.TotalDays, t.Hours, t.Minutes, t.Seconds);
        if (t.TotalHours >= 1) return string.Format("{0}h {1}m {2}s", (int)t.TotalHours, t.Minutes, t.Seconds);
        if (t.TotalMinutes >= 1) return string.Format("{0}m {1}s", (int)t.TotalMinutes, t.Seconds);
        return string.Format("{0}s", (int)t.TotalSeconds);
    }
}
