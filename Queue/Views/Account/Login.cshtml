@model Queue.Models.LoginViewModel
@using Queue.Models.Components
@{
    ViewBag.Title = "Iniciar sesión";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<div id="login-panel">
    <p class="text-xs font-semibold uppercase tracking-widest text-[#6d5fb9]">Bienvenido de nuevo</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-800">Inicia sesión</h1>
    <p class="mt-3 text-sm leading-relaxed text-slate-500">Ingresa tus datos para acceder a tu espacio de trabajo.</p>
    @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl ?? Request["returnUrl"] }, FormMethod.Post, new { id = "login-form", @class = "mt-8 space-y-5" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "rounded-lg text-sm text-rose-600", role = "alert" })
        @Html.Partial("~/Views/Shared/Components/Inputs/_Field.cshtml", new EmailInput { Name = "Email", Label = "Correo electrónico", Value = Model == null ? null : Model.Email, Required = true, Placeholder = "nombre@empresa.com", Autocomplete = "username" }, new ViewDataDictionary(ViewData))
        @Html.Partial("~/Views/Shared/Components/Inputs/_Field.cshtml", new PasswordInput { Name = "Password", Label = "Contraseña", Required = true, Placeholder = "Ingresa tu contraseña", Autocomplete = "current-password" }, new ViewDataDictionary(ViewData))
        @Html.Partial("~/Views/Shared/Components/Inputs/_Field.cshtml", new CheckboxInput { Name = "RememberMe", Label = "Mantener la sesión iniciada", Value = Model != null && Model.RememberMe }, new ViewDataDictionary(ViewData))
        <div class="flex justify-end"><button type="button" id="show-recovery" class="rounded text-sm font-medium text-[#6d5fb9] hover:underline focus:outline-none focus:ring-4 focus:ring-[#6d5fb9]/20">¿Olvidaste tu contraseña?</button></div>
        <button type="submit" class="w-full rounded-xl bg-[#6d5fb9] px-5 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#594b9c] focus:outline-none focus:ring-4 focus:ring-[#6d5fb9]/20">Ingresar</button>
    }
</div>
<div id="recovery-panel" hidden>
    <p class="text-xs font-semibold uppercase tracking-widest text-[#6d5fb9]">Recupera tu acceso</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-800">Restablecer contraseña</h1>
    <p class="mt-3 text-sm leading-relaxed text-slate-500">Ingresa tu correo electrónico para solicitar las instrucciones de recuperación.</p>
    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @class = "mt-8 space-y-5" }))
    {
        @Html.AntiForgeryToken()
        <label for="recovery-email" class="block text-sm font-semibold text-slate-700">Correo electrónico</label>
        @Html.Partial("~/Views/Shared/Components/Inputs/_Text.cshtml", new EmailInput { Name = "Email", Id = "recovery-email", Required = true, Placeholder = "nombre@empresa.com", Autocomplete = "email" }, new ViewDataDictionary())
        <button type="submit" class="w-full rounded-xl bg-[#6d5fb9] px-5 py-3.5 text-sm font-semibold text-white hover:bg-[#594b9c] focus:outline-none focus:ring-4 focus:ring-[#6d5fb9]/20">Enviar instrucciones</button>
        <button type="button" id="show-login" class="w-full rounded-xl border border-slate-200 px-5 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-[#6d5fb9]/20">Volver a iniciar sesión</button>
    }
</div>
<p class="mt-8 text-center text-xs leading-relaxed text-slate-400">Accede con la cuenta asociada a tu empresa.</p>
@section Scripts {
<script>
(function () {
    var login = document.getElementById('login-panel');
    var recovery = document.getElementById('recovery-panel');
    var recoveryEmail = recovery.querySelector('input[type="email"]');
    recoveryEmail.removeAttribute('aria-describedby');
    document.getElementById('show-recovery').addEventListener('click', function () {
        recoveryEmail.value = login.querySelector('input[type="email"]').value;
        login.hidden = true; recovery.hidden = false; recoveryEmail.focus();
    });
    document.getElementById('show-login').addEventListener('click', function () {
        recovery.hidden = true; login.hidden = false; login.querySelector('input[type="email"]').focus();
    });
})();
</script>
}

