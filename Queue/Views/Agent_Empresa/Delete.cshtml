@model Queue.Models.Agent_Empresa
@using Queue.Models.Components
@{
    ViewBag.Title = "Eliminar empresa";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var detail = new DetailComponent {
        Title = "Eliminar empresa", Description = "Revisa la empresa antes de confirmar. También se eliminarán su configuración, licencias, funcionalidades y horarios asociados.",
        Fields = new System.Collections.Generic.List<DetailField> {
            new DetailField { Label = "Empresa", Value = Model.Nombre },
            new DetailField { Label = "Identificación tributaria", Value = Model.Rut },
            new DetailField { Label = "Correo electrónico", Value = Model.Email },
            new DetailField { Label = "Teléfono", Value = Model.Telefono },
            new DetailField { Label = "Dirección", Value = Model.Direccion },
            new DetailField { Label = "Estado", Value = Model.status ? "Activa" : "Inactiva" }
        }
    };
    var form = new FormComponent {
        Id = "delete-company-form", Title = "Confirmar eliminación", Description = "Esta acción elimina los registros indicados y no se puede deshacer desde el aplicativo.",
        ActionUrl = Url.Action("Delete", new { id = Model.IdCompany }), CancelUrl = Url.Action("Index"), SubmitLabel = "Eliminar empresa", SingleColumn = true,
        Inputs = new System.Collections.Generic.List<IFormInput> { new HiddenInput { Name = "id", Value = Model.IdCompany } }
    };
}
<div class="space-y-6">
    @Html.Partial("~/Views/Shared/Components/Details/_Details.cshtml", detail)
    @Html.Partial("~/Views/Shared/Components/Forms/_Form.cshtml", form, new ViewDataDictionary(ViewData))
</div>
