@model Queue.Models.Agent_Empresa
@using Queue.Models.Components
@{
    ViewBag.Title = "Detalle de empresa";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var detail = new DetailComponent {
        Title = Model.Nombre, Description = "Información de la empresa.",
        Fields = new System.Collections.Generic.List<DetailField> {
            new DetailField { Label = "Identificación tributaria", Value = Model.Rut },
            new DetailField { Label = "Correo electrónico", Value = Model.Email },
            new DetailField { Label = "Teléfono", Value = Model.Telefono },
            new DetailField { Label = "Dirección", Value = Model.Direccion },
            new DetailField { Label = "Estado", Value = Model.status ? "Activa" : "Inactiva" }
        },
        Actions = new System.Collections.Generic.List<TableCell> {
            TableCell.Link("Volver a empresas", Url.Action("Index")),
            TableCell.Link("Editar empresa", Url.Action("Edit", new { id = Model.IdCompany })),
            TableCell.Link("Configurar agente", Url.Action("Create", "Agent_Configuration", new { id = Model.IdCompany })),
            TableCell.Link("Ver funcionalidades", Url.Action("Index", "Functionality", new { IdCompany = Model.IdCompany })),
            TableCell.Link("Ver licencias", Url.Action("Index", "Licenses", new { idempresa = Model.IdCompany }))
        }
    };
}
@Html.Partial("~/Views/Shared/Components/Details/_Details.cshtml", detail)
