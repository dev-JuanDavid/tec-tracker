@model IEnumerable<Queue.Models.Agent_Empresa>
@using Queue.Models
@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Empresas";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var table = TableComponent.From(Model ?? Enumerable.Empty<Agent_Empresa>(),
        new TableColumn<Agent_Empresa> { Title = "Empresa", Cell = item => TableCell.Link(item.Nombre, Url.Action("Details", new { id = item.IdCompany })) },
        new TableColumn<Agent_Empresa> { Title = "Identificación tributaria", Cell = item => TableCell.Text(item.Rut) },
        new TableColumn<Agent_Empresa> { Title = "Correo electrónico", Cell = item => TableCell.Text(item.Email) },
        new TableColumn<Agent_Empresa> { Title = "Teléfono", Cell = item => TableCell.Text(item.Telefono) },
        new TableColumn<Agent_Empresa> { Title = "Dirección", Cell = item => TableCell.Text(item.Direccion) },
        new TableColumn<Agent_Empresa> { Title = "Estado", Cell = item => TableCell.Badge(item.status ? "Activa" : "Inactiva", item.status) },
        new TableColumn<Agent_Empresa> { Title = "Editar", Cell = item => TableCell.Link("Editar", Url.Action("Edit", new { id = item.IdCompany })) },
        new TableColumn<Agent_Empresa> { Title = "Configuración", Cell = item => TableCell.Link("Configurar", Url.Action("Create", "Agent_Configuration", new { id = item.IdCompany })) },
        new TableColumn<Agent_Empresa> { Title = "Licencias", Cell = item => TableCell.Link("Ver licencias", Url.Action("Index", "Licenses", new { idempresa = item.IdCompany })) },
        new TableColumn<Agent_Empresa> { Title = "Funcionalidades", Cell = item => TableCell.Link("Ver funcionalidades", Url.Action("Index", "Functionality", new { IdCompany = item.IdCompany })) },
        new TableColumn<Agent_Empresa> { Title = "Eliminar", Cell = item => TableCell.Link("Eliminar", Url.Action("Delete", new { id = item.IdCompany })) });
    table.Title = "Empresas";
    table.Description = "Administra las empresas y accede a su configuración, licencias y funcionalidades.";
    table.CreateUrl = Url.Action("Create");
    table.CreateLabel = "Nueva empresa";
    table.EmptyMessage = "No hay empresas registradas. Crea una empresa para comenzar.";
}
@Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)
