@model Queue.Models.ParameterSystem
@using Queue.Models.Components
@{
    ViewBag.Title = "Editar parámetros del sistema";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var form = new FormComponent {
        Id = "system-parameters-form", Title = "Editar parámetros del sistema",
        Description = "Empresa: " + Model.Company + ". Configura los intervalos de operación del agente.",
        ActionUrl = Url.Action("EditParameterSystem", "Operation"), CancelUrl = Url.Action("ParameterSystem", "Operation"),
        SubmitLabel = "Guardar parámetros",
        Inputs = new System.Collections.Generic.List<IFormInput> {
            new HiddenInput { Name = "Id_Configuration", Value = Model.Id_Configuration },
            new HiddenInput { Name = "IdCompany", Value = Model.IdCompany },
            new NumberInput { Name = "InactivityPeriod", Label = "Período de inactividad", Value = Model.InactivityPeriod, Required = true, Min = "0", Step = "1", Help = "Tiempo de inactividad, expresado en segundos." },
            new NumberInput { Name = "CaptureFrecuency", Label = "Frecuencia de capturas", Value = Model.CaptureFrecuency, Required = true, Min = "0", Step = "1", Help = "Intervalo entre capturas de pantalla, expresado en segundos." },
            new NumberInput { Name = "UploadFrecuency", Label = "Frecuencia de envío de datos", Value = Model.UploadFrecuency, Required = true, Min = "0", Step = "1", Help = "Intervalo de envío de datos, expresado en segundos." },
            new NumberInput { Name = "LocationFrecuency", Label = "Frecuencia de ubicación", Value = Model.LocationFrecuency, Required = true, Min = "0", Step = "1", Help = "Intervalo de actualización de ubicación, expresado en minutos." }
        }
    };
}
@Html.Partial("~/Views/Shared/Components/Forms/_Form.cshtml", form, new ViewDataDictionary(ViewData))

