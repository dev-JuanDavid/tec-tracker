@model IEnumerable<Queue.Models.HardwareReport>
@using Queue.Models
@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Detalle de hardware";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var table = TableComponent.From(Model ?? Enumerable.Empty<HardwareReport>(),
        new TableColumn<HardwareReport> { Title = "Tipo", Cell = component => TableCell.Text(component.type) },
        new TableColumn<HardwareReport> { Title = "Componente", Cell = component => TableCell.Text(component.hardware) },
        new TableColumn<HardwareReport> { Title = "Equipo", Cell = component => TableCell.Text(component.agrupation) });
    table.Title = "Equipos con el componente registrado";
    table.Description = "Componente: " + Request["hardware"] + ". Las exportaciones incluyen todos los resultados de la búsqueda.";
    table.EmptyMessage = "No hay equipos para el componente y los filtros seleccionados.";
    table.EnableExport = true;
    table.Actions.Add(TableCell.Link("Volver al reporte", Url.Action("HardwareReport", "Operation", new { idgroup = Request["idgroup"], user = Request["user"] })));
}
@Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)

