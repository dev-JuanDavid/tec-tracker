@model IEnumerable<Queue.Models.HardwareReport>
@using Queue.Models
@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Reporte de hardware";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var selectedGroup = Request["idgroup"];
    var selectedUser = Request["user"];
    var groups = (ViewBag.idgroup as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>()).Select(g => new SelectListItem {
        Value = g.Value, Text = g.Value == Guid.Empty.ToString() ? "Todos los grupos" : g.Text
    }).ToList();
    var form = new FormComponent {
        Id = "hardware-report-filters", Title = "Consultar hardware", Description = "Selecciona un grupo o empleado para consultar los componentes registrados.",
        ActionUrl = Url.Action("HardwareReport", "Operation"), UseGet = true, SubmitLabel = "Consultar reporte",
        Inputs = new System.Collections.Generic.List<IFormInput> {
            new SelectInput { Name = "idgroup", Label = "Grupo", Options = groups, Value = selectedGroup ?? Guid.Empty.ToString(), EmptyLabel = null },
            new SelectInput { Name = "user", Label = "Empleado", Options = ViewData["UserList"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>(), Value = selectedUser, EmptyLabel = "Todos los empleados", DependsOn = "idgroup", OptionsUrl = Url.Action("GetUserByArea", "Operation") }
        }
    };
    var table = TableComponent.From(Model ?? Enumerable.Empty<HardwareReport>(),
        new TableColumn<HardwareReport> { Title = "Tipo", Cell = component => TableCell.Text(component.type) },
        new TableColumn<HardwareReport> { Title = "Componente", Cell = component => TableCell.Text(component.hardware) },
        new TableColumn<HardwareReport> { Title = "Cantidad", Cell = component => TableCell.Text(component.quantity) },
        new TableColumn<HardwareReport> { Title = "Acciones", Cell = component => TableCell.Link("Ver equipos", Url.Action("HardwareReportDetails", "Operation", new { hardware = component.hardware, idgroup = selectedGroup, user = selectedUser })) });
    table.Title = "Hardware registrado";
    table.Description = "Las exportaciones incluyen todos los registros que coinciden con la búsqueda.";
    table.EmptyMessage = "No hay componentes para los filtros seleccionados.";
    table.EnableExport = true;
}
<div class="space-y-6">
    <header>
        <p class="text-xs font-semibold uppercase tracking-widest text-[#6d5fb9]">Inventario de equipos</p>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-800">Reporte de hardware</h1>
        <p class="mt-2 text-sm text-slate-500">Consulta los componentes registrados y los equipos a los que pertenecen.</p>
    </header>
    @Html.Partial("~/Views/Shared/Components/Forms/_Form.cshtml", form, new ViewDataDictionary(ViewData))
    @Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)
</div>

