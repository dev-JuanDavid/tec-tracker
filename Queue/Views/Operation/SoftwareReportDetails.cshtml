@model IEnumerable<Queue.Models.SoftwareReport>
@using Queue.Models
@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Equipos con el programa instalado";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var table = TableComponent.From(Model ?? Enumerable.Empty<SoftwareReport>(),
        new TableColumn<SoftwareReport> { Title = "Programa", Cell = software => TableCell.Text(software.program) },
        new TableColumn<SoftwareReport> { Title = "Equipo", Cell = software => TableCell.Text(software.agrupation) });
    table.Title = "Equipos con el programa instalado";
    table.Description = "Programa: " + Request["name"] + ". Las exportaciones incluyen todos los resultados de la búsqueda.";
    table.EmptyMessage = "No hay equipos para el programa y los filtros seleccionados.";
    table.EnableExport = true;
    table.Actions.Add(TableCell.Link("Volver al reporte", Url.Action("SoftwareReport", "Operation", new { idgroup = Request["idgroup"], user = Request["user"] })));
}
@Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)

