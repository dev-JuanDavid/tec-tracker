@model IEnumerable<Queue.Models.ParameterSystem>
@using Queue.Models
@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Parámetros del sistema";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var table = TableComponent.From(Model ?? Enumerable.Empty<ParameterSystem>(),
        new TableColumn<ParameterSystem> { Title = "Empresa", Cell = parameter => TableCell.Text(parameter.Company) },
        new TableColumn<ParameterSystem> { Title = "Inactividad (segundos)", Cell = parameter => TableCell.Text(parameter.InactivityPeriod) },
        new TableColumn<ParameterSystem> { Title = "Capturas (segundos)", Cell = parameter => TableCell.Text(parameter.CaptureFrecuency) },
        new TableColumn<ParameterSystem> { Title = "Envío de datos (segundos)", Cell = parameter => TableCell.Text(parameter.UploadFrecuency) },
        new TableColumn<ParameterSystem> { Title = "Ubicación (minutos)", Cell = parameter => TableCell.Text(parameter.LocationFrecuency) },
        new TableColumn<ParameterSystem> { Title = "Fecha de creación", Cell = parameter => TableCell.Text(parameter.DateCreation.ToString("dd/MM/yyyy")) },
        new TableColumn<ParameterSystem> { Title = "Acciones", Cell = parameter => TableCell.Link("Editar parámetros", Url.Action("EditParameterSystem", "Operation", new { id = parameter.Id_Configuration })) });
    table.Title = "Parámetros del sistema";
    table.Description = "Consulta los intervalos de actividad, capturas, envío de datos y ubicación de tu empresa.";
    table.EmptyMessage = "No hay parámetros configurados para esta empresa.";
}
@Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)

