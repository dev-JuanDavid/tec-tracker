@model IEnumerable<Queue.Models.Functionality>
@using Queue.Models
@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Funcionalidades de la empresa";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    Guid company = ViewBag.IdCompany;
    var table = TableComponent.From(Model ?? Enumerable.Empty<Functionality>(),
        new TableColumn<Functionality> { Title = "Funcionalidad", Cell = item => TableCell.Text(item.Name) },
        new TableColumn<Functionality> { Title = "Estado del catálogo", Cell = item => TableCell.Badge(item.Active ? "Activa" : "Inactiva", item.Active) },
        new TableColumn<Functionality> { Title = "Detalle", Cell = item => TableCell.Link("Ver detalle", Url.Action("Details", new { id = item.IdFunctionality, idCompany = company })) },
        new TableColumn<Functionality> { Title = "Retirar", Cell = item => TableCell.Link("Retirar de la empresa", Url.Action("Delete", new { idCompany = company, idFunctionality = item.IdFunctionality })) });
    table.Title = "Funcionalidades"; table.Description = "Empresa: " + ViewBag.CompanyName + ". Administra las funcionalidades asignadas desde el catálogo.";
    table.CreateUrl = Url.Action("Create", new { idCompany = company }); table.CreateLabel = "Asignar funcionalidad";
    table.EmptyMessage = "Esta empresa no tiene funcionalidades asignadas.";
    table.Actions.Add(TableCell.Link("Volver a empresa", Url.Action("Details", "Agent_Empresa", new { id = company })));
}
@Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)
