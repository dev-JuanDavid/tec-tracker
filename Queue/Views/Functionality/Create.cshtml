@model Queue.Models.Functionality
@using Queue.Models.Components
@{
    ViewBag.Title = "Asignar funcionalidad";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var form = new FormComponent {
        Id = "company-functionality-form", Title = "Asignar funcionalidad", SingleColumn = true,
        Description = "Selecciona una funcionalidad activa del catálogo para habilitarla en esta empresa.",
        ActionUrl = Url.Action("Create"), CancelUrl = Url.Action("Index", new { idCompany = Model.IdCompany }), SubmitLabel = "Asignar funcionalidad",
        Inputs = new System.Collections.Generic.List<IFormInput> {
            new HiddenInput { Name = "IdCompany", Value = Model.IdCompany },
            new SelectInput { Name = "IdFunctionality", Label = "Funcionalidad", Value = Model.IdFunctionality, Required = true, EmptyLabel = "Selecciona una funcionalidad", Options = (IEnumerable<SelectListItem>)ViewBag.Functionality }
        }
    };
}
@Html.Partial("~/Views/Shared/Components/Forms/_Form.cshtml", form, new ViewDataDictionary(ViewData))
