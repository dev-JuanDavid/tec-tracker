@model Queue.Models.Functionality
@using Queue.Models.Components
@{
    ViewBag.Title = "Editar catálogo de funcionalidades";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var form = new FormComponent {
        Id = "edit-functionality-catalog", Title = ViewBag.Title,
        Description = "Estos cambios afectan al catálogo compartido y a todas las empresas que tienen asignada esta funcionalidad.",
        ActionUrl = Url.Action("Edit"), CancelUrl = Url.Action("Index", new { idCompany = Model.IdCompany }), SubmitLabel = "Guardar cambios",
        Inputs = new System.Collections.Generic.List<IFormInput> {
            new HiddenInput { Name = "IdFunctionality", Value = Model.IdFunctionality }, new HiddenInput { Name = "IdCompany", Value = Model.IdCompany },
            new TextInput { Name = "Name", Label = "Nombre de la funcionalidad", Value = Model.Name, Required = true },
            new CheckboxInput { Name = "Active", Label = "Activa en el catálogo", Value = Model.Active }
        }
    };
}
@Html.Partial("~/Views/Shared/Components/Forms/_Form.cshtml", form, new ViewDataDictionary(ViewData))
