@model Queue.Models.Functionality
@using Queue.Models.Components
@{
    ViewBag.Title = "Funcionalidad de empresa";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var detail = new DetailComponent {
        Title = Model.Name, Description = "Información de la funcionalidad del catálogo.",
        Fields = new System.Collections.Generic.List<DetailField> { new DetailField { Label = "Estado", Value = Model.Active ? "Activa" : "Inactiva" } },
        Actions = new System.Collections.Generic.List<TableCell> { TableCell.Link("Volver a funcionalidades", Url.Action("Index", new { idCompany = Model.IdCompany })) }
    };

}
<div class="space-y-6">
    @Html.Partial("~/Views/Shared/Components/Details/_Details.cshtml", detail)
    
</div>
