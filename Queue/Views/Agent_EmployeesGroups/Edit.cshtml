@model Queue.Models.Agent_EmployeesGroups

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex flex-col gap-6">

    <!-- Editar Grupo -->
    <div class="bg-white shadow-md rounded-xl p-6">
        <div class="flex items-center justify-between border-b pb-3 mb-4">
            <h4 class="text-xl font-semibold text-gray-700">Editar Grupo Usuario</h4>
            <a href="@Url.Action("Index", "Agent_EmployeesGroups")"
               class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg shadow flex items-center gap-2 text-sm">
                <i class="glyphicon glyphicon-chevron-left"></i> Back
            </a>
        </div>

        @using (Html.BeginForm("Edit", "Agent_EmployeesGroups"))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.idemployeesGroup)

            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    @Html.LabelFor(model => model.Nombre)
                </label>
                @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200" } })
                <span class="text-red-500 text-xs">
                    @Html.ValidationMessageFor(model => model.Nombre)
                </span>
            </div>

            <div class="flex justify-end">
                <button type="submit"
                        class="bg-yellow-500 hover:bg-yellow-600 text-white px-5 py-2 rounded-lg shadow">
                    Editar
                </button>
            </div>
        }
    </div>

    <!-- Agregar Usuario -->
    @using (Html.BeginForm("Addemployee", "Agent_EmployeesGroups"))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.idemployeesGroup)

        <div class="bg-white shadow-md rounded-xl p-6">
            <div class="flex items-center justify-between border-b pb-3 mb-4">
                <h4 class="text-xl font-semibold text-gray-700">Agregar Usuario</h4>
            </div>

            <div class="mb-6">
                <label for="idemployee" class="block text-sm font-medium text-gray-700 mb-1">
                    Usuario
                </label>
                @Html.DropDownList("idemployee", ViewBag.idemployee as SelectList,
                    htmlAttributes: new
                    {
                        @class = "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200",
                        autocomplete = "off"
                    })
                <span class="text-red-500 text-xs">
                    @Html.ValidationMessage("idemployee")
                </span>
            </div>

            <div class="flex justify-end mb-6">
                <button type="submit"
                        class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg shadow">
                    Agregar
                </button>
            </div>

            <!-- Tabla de usuarios del grupo -->
            <div class="overflow-x-auto">
                <table class="min-w-full border border-gray-200 rounded-lg">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-4 py-2 text-left text-sm font-medium text-gray-600 border-b">Nombres</th>
                            <th class="px-4 py-2 text-left text-sm font-medium text-gray-600 border-b">Usuario</th>
                            <th class="px-4 py-2 text-center text-sm font-medium text-gray-600 border-b">Eliminar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Agent_EmployeeGroupsEmployee_list)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-2 text-gray-700 border-b">
                                    @Html.DisplayFor(modelItem => item.Nombre)
                                </td>
                                <td class="px-4 py-2 text-gray-700 border-b">
                                    @Html.DisplayFor(modelItem => item.Usuario)
                                </td>
                                <td class="px-4 py-2 text-center border-b">
                                    <a href="@Url.Action("Deleteemployee", "Agent_EmployeesGroups",
new { idEmployee = item.idEmployee, idAgent_EmployeeGroupsEmployee = Model.idemployeesGroup })"
                                       class="btn btn-outline-secondary">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script>
    $(document).ready(function () {
        // Aquí podrías inicializar DataTable o algún script adicional si lo deseas
    });
</script>
