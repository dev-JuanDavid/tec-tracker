@model Queue.Models.Agent_EmployeesGroups
@using Queue.Models
@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Editar grupo";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var assignment = new FormComponent {
        Id = "group-assignment-form", Title = "Agregar empleado", Description = "Selecciona un empleado que todavía no forme parte de este grupo.",
        ActionUrl = Url.Action("Addemployee", "Agent_EmployeesGroups"), SubmitLabel = "Agregar al grupo",
        Inputs = new System.Collections.Generic.List<IFormInput> {
            new HiddenInput { Name = "idemployeesGroup", Value = Model.idemployeesGroup },
            new SelectInput { Name = "idemployee", Label = "Empleado", Required = true, EmptyLabel = "Selecciona un empleado", Options = ViewBag.idemployee as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>() }
        }
    };
    var table = TableComponent.From(Model.Agent_EmployeeGroupsEmployee_list,
        new TableColumn<Agent_Employee> { Title = "Nombre", Cell = employee => TableCell.Text(employee.Nombre) },
        new TableColumn<Agent_Employee> { Title = "Usuario", Cell = employee => TableCell.Text(employee.Usuario) },
        new TableColumn<Agent_Employee> { Title = "Acciones", Cell = employee => TableCell.Link("Quitar del grupo", Url.Action("Deleteemployee", "Agent_EmployeesGroups", new { idEmployee = employee.idEmployee, idAgent_EmployeeGroupsEmployee = Model.idemployeesGroup })) });
    table.Title = "Integrantes del grupo";
    table.Description = "Consulta o modifica los empleados asociados.";
    table.EmptyMessage = "Este grupo todavía no tiene empleados.";
}
<div class="space-y-6">
    @Html.Partial("~/Views/Shared/Components/Forms/_EmployeeGroupForm.cshtml", Model, new ViewDataDictionary(ViewData))
    @Html.Partial("~/Views/Shared/Components/Forms/_Form.cshtml", assignment, new ViewDataDictionary(ViewData))
    @Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)
</div>

