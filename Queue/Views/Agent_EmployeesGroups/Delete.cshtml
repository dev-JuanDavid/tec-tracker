@model Queue.Models.Agent_EmployeesGroups
@using Queue.Models.Components
@{
    ViewBag.Title = "Eliminar grupo";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var form = new FormComponent {
        Id = "delete-group-form", Title = "Eliminar grupo",
        Description = "Confirma la eliminación del grupo «" + Model.Nombre + "».",
        ActionUrl = Url.Action("Delete", "Agent_EmployeesGroups", new { id = Model.idemployeesGroup }),
        CancelUrl = Url.Action("Index", "Agent_EmployeesGroups"), SubmitLabel = "Eliminar grupo",
        Inputs = new System.Collections.Generic.List<IFormInput> { new HiddenInput { Name = "id", Value = Model.idemployeesGroup } }
    };
}
@Html.Partial("~/Views/Shared/Components/Forms/_Form.cshtml", form, new ViewDataDictionary(ViewData))

