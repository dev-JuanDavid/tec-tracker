@model IEnumerable<Queue.Models.Agent_EmployeesGroups>
@using Queue.Models
@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Grupos de empleados";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var table = TableComponent.From(Model ?? Enumerable.Empty<Agent_EmployeesGroups>(),
        new TableColumn<Agent_EmployeesGroups> { Title = "Nombre", Cell = group => TableCell.Text(group.Nombre) },
        new TableColumn<Agent_EmployeesGroups> { Title = "Editar", Cell = group => TableCell.Link("Editar", Url.Action("Edit", "Agent_EmployeesGroups", new { id = group.idemployeesGroup })) },
        new TableColumn<Agent_EmployeesGroups> { Title = "Eliminar", Cell = group => TableCell.Link("Eliminar", Url.Action("Delete", "Agent_EmployeesGroups", new { id = group.idemployeesGroup })) });
    table.Title = "Grupos de empleados";
    table.Description = "Organiza los equipos y administra sus integrantes.";
    table.CreateUrl = Url.Action("Create", "Agent_EmployeesGroups");
    table.CreateLabel = "Nuevo grupo";
    table.EmptyMessage = "Crea un grupo para comenzar a organizar a tus empleados.";
}
@Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)

