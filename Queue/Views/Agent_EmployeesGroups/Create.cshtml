@model Queue.Models.Agent_EmployeesGroups

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Create", "Agent_EmployeesGroups", FormMethod.Post, new { id = "frm_register" }))
{
    @Html.AntiForgeryToken()

    <div id="divblock" class="w-full">
        <div class="bg-white shadow rounded-2xl p-6">

            <!-- Encabezado -->
            <div class="flex justify-between items-center mb-6">
                <h4 class="text-xl font-semibold text-gray-800">Crear Grupo Usuarios</h4>
                <a href="@Url.Action("Index", "Agent_EmployeesGroups")"
                   class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white text-sm font-medium rounded-lg shadow transition">
                    ← Back
                </a>
            </div>

            <!-- Formulario con Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    @Html.LabelFor(model => model.Nombre, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                    @Html.EditorFor(model => model.Nombre, new
                    {
                        htmlAttributes = new
                        {
                            @class = "block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                        }
                    })
                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>
            </div>

            <!-- Botón -->
            <div class="flex justify-end mt-6">
                <button id="add_company" name="add_dictionary" type="submit" value="Create"
                        class="px-5 py-2 bg-blue-500 hover:bg-blue-600 text-white text-sm font-medium rounded-lg shadow transition">
                    Add
                </button>
            </div>
        </div>
    </div>
}
