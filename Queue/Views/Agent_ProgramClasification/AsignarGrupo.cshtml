@model Queue.Models.Agent_ProgramClasification

@{
    ViewBag.Title = "Asignar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="divblock" class="row">
    <div class="col-lg-12 col-12">
        <div class="box">
            <div class="box-header with-border">
                <h4 class="box-title">Editar Grupo Usuario</h4>
            </div>

            <div class="box-body">
                <div class="form-group">
                    @* Obtener Nombre del Programa y Clasificación *@
                    <h4 class="text-asig">@ViewBag.nombrePrograma</h4>
                    <h2>
                        @if (Model.clasification == 1)
                        {
                            <label>Productiva</label>
                        }
                        else if (Model.clasification == 2)
                        {
                            <label>Improductiva</label>
                        }
                        else
                        {
                            <label>Neutral</label>
                        }
                    </h2>
                </div>

                <div class="form-actions">
                    <a href="@Url.Action("Index", "Agent_ProgramClasification")" class="btn btn-info float-right">
                        <i class="glyphicon glyphicon-chevron-left"></i> Volver
                    </a>
                </div>
            </div>

            @using (Html.BeginForm("AddGrupo", "Agent_ProgramClasification"))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.idprogramclasification)
                @Html.HiddenFor(m => m.clasification)

                <div class="box">
                    <div class="box-header with-border">
                        <h4 class="box-title">Agregar Grupo</h4>
                    </div>
                    <div class="box-body">
                        <div class="form-group">
                            <label for="idemployeesGroup">Grupo</label>
                            <span asp-validation-for="idemployeesGroup" class="text-danger"></span>
                            @Html.DropDownList("idemployeesGroup", ViewBag.idemployee as SelectList, new { @class = "form-control", autocomplete = "off" })
                        </div>
                    </div>
                    <div class="form-actions">
                        <div class="d-flex flex-row-reverse">
                            <div class="p-2">
                                <button id="AsignarGrupo" name="add_dictionary" type="submit" class="btn btn-info">
                                    Añadir
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                // Alertas de Error o Validación al Asignar Grupos
                <div class="box-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }
                    @if (!ViewData.ModelState.IsValid)
                    {
                        foreach (var state in ViewData.ModelState.Values)
                        {
                            foreach (var error in state.Errors)
                            {
                                <div class="alert alert-danger">@error.ErrorMessage</div>
                            }
                        }
                    }
                </div>

                <div class="table-responsive">
                    <table id="myTable" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Nombres</th>
                                <th>Usuario</th>
                                <th>Eliminar</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.ClasificationGroups)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.Agent_EmployeesGroups.Nombre)</td>
                                    <td>
                                        <a class="btn btn-outline-secondary" href="@Url.Action("Edit", "Agent_EmployeesGroups", new { id = item.idemployeesGroup })">
                                            <i class="mdi mdi-account-circle"></i>
                                        </a>
                                    </td>
                                    <td>
                                        <a class="btn btn-outline-secondary" href="@Url.Action("DeleteProgramGroup", "Agent_ProgramClasification", new { Id = item.Id, idprogramclasification = item.idprogramclasification })">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script>
    $(document).ready(function () {
        const dropdown = $('#idemployeesGroup');
        const addButton = $('#AsignarGrupo');

        function checkDropdown() {
            addButton.prop('disabled', dropdown.children('option').length === 0);
        }

        dropdown.on('change', checkDropdown);
        checkDropdown();
    });
</script>
