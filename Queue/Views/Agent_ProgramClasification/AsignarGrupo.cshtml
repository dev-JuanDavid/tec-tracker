@model Queue.Models.Agent_ProgramClasification
@using Queue.Models
@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Grupos del programa";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var groups = (ViewBag.idemployeesGroup as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>()).ToList();
    var assigned = ViewBag.asigemp as IEnumerable<Agent_ClasificationGroup> ?? Model.ClasificationGroups;
    var table = TableComponent.From(assigned,
        new TableColumn<Agent_ClasificationGroup> { Title = "Grupo", Cell = g => TableCell.Text(g.Agent_EmployeesGroups == null ? "" : g.Agent_EmployeesGroups.Nombre) },
        new TableColumn<Agent_ClasificationGroup> { Title = "Integrantes", Cell = g => TableCell.Link("Ver grupo", Url.Action("Edit", "Agent_EmployeesGroups", new { id = g.idemployeesGroup })) },
        new TableColumn<Agent_ClasificationGroup> { Title = "Acciones", Cell = g => TableCell.Link("Quitar asignación", Url.Action("DeleteProgramGroup", "Agent_ProgramClasification", new { Id = g.Id, idprogramclasification = Model.idprogramclasification })) });
    table.Title = "Grupos asignados";
    table.Description = "Programa: " + Model.name + " · " + (Model.clasification == 1 ? "Productiva" : Model.clasification == 2 ? "Improductiva" : "Neutral");
    table.EmptyMessage = "Esta clasificación todavía no tiene grupos asignados.";
    var form = new FormComponent {
        Id = "classification-group-form", Title = "Asignar grupo", Description = "Selecciona un grupo disponible para esta clasificación.",
        ActionUrl = Url.Action("AddGrupo", "Agent_ProgramClasification"), CancelUrl = Url.Action("Index", "Agent_ProgramClasification"), SubmitLabel = "Asignar grupo",
        Inputs = new System.Collections.Generic.List<IFormInput> {
            new HiddenInput { Name = "idprogramclasification", Value = Model.idprogramclasification },
            new HiddenInput { Name = "clasification", Value = Model.clasification },
            new SelectInput { Name = "idemployeesGroup", Label = "Grupo", Options = groups, Required = true, EmptyLabel = "Selecciona un grupo" }
        }
    };
}
<div class="space-y-6">
    @if (groups.Count > 0) {
        @Html.Partial("~/Views/Shared/Components/Forms/_Form.cshtml", form, new ViewDataDictionary(ViewData))
    } else {
        @Html.Partial("~/Views/Shared/Components/Details/_Details.cshtml", new DetailComponent {
            Title = "Grupos del programa", Description = "No hay grupos disponibles para asignar a esta clasificación.",
            Actions = new System.Collections.Generic.List<TableCell> { TableCell.Link("Volver a clasificaciones", Url.Action("Index", "Agent_ProgramClasification")) }
        })
    }
    @Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)
</div>

