@model Queue.Models.Agent_ProgramClasification
@using Queue.Models.Components
@{
    ViewBag.Title = "Detalle de clasificación";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var detail = new DetailComponent {
        Title = "Detalle de clasificación",
        Fields = new System.Collections.Generic.List<DetailField> {
            new DetailField { Label = "Programa", Value = Model.name },
            new DetailField { Label = "Clasificación", Value = Model.clasification == 1 ? "Productiva" : Model.clasification == 2 ? "Improductiva" : Model.clasification == 3 ? "Neutral" : "Sin clasificar" }
        },
        Actions = new System.Collections.Generic.List<TableCell> {
            TableCell.Link("Volver", Url.Action("Index", "Agent_ProgramClasification")),
            TableCell.Link("Editar", Url.Action("Edit", "Agent_ProgramClasification", new { id = Model.idprogramclasification }))
        }
    };
}
@Html.Partial("~/Views/Shared/Components/Details/_Details.cshtml", detail)

