@model Queue.Models.Agent_ProgramClasification

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@using (Html.BeginForm("Create", "Agent_ProgramClasification", FormMethod.Post, new { id = "frm_register" }))
{
    @Html.AntiForgeryToken()

    <div id="divblock" class="row">
        <div class="col-lg-12 col-12">

            <div class="box">
                <div class="box-header with-border">
                    <h4 class="box-title">Clasificación de programas</h4>

                </div>
                <div class="col-md-2">
                    <a href="@Url.Action("Index", "Agent_ProgramClasification")" class="btn btn-info btn-block m-t-10 float-right">
                        <i class="glyphicon glyphicon-chevron-left"></i> Atras
                    </a>
                </div>

                <div class="box-body">

                    <div class="form-group">
                        <div class="row">
                            <div class="col-6">
                                <h4 class="box-title">@ViewBag.noprograms</h4>
                            </div>
                        </div>
                    </div>

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="form-group">
                        <div class="row">
                            <div class="col-lg-6">
                                @Html.LabelFor(model => model.name, htmlAttributes: new { @class = "control-label" })
                                @Html.ValidationMessageFor(model => model.name, "", new { @class = "text-danger" })
                                <div class="input-group">
                                    @Html.DropDownList("name", ViewBag.name as SelectList, htmlAttributes: new { @class = "form-control", autocomplete = "off" })
                                </div>
                                <br />
                            </div>
                            <div class="col-lg-6">
                                @Html.LabelFor(model => model.clasification, htmlAttributes: new { @class = "control-label" })
                                @Html.ValidationMessageFor(model => model.clasification, "", new { @class = "text-danger" })
                                <div class="input-group">
                                    <select id="clasification" name="clasification" class="form-control">
                                        <option value="1">Productiva</option>
                                        <option value="2">Improductiva</option>
                                        <option value="3">Neutral</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                @Html.LabelFor(model => model.isLicensed, htmlAttributes: new { @class = "control-label" })
                                @Html.ValidationMessageFor(model => model.isLicensed, "", new { @class = "text-danger" })
                                <div class="input-group">
                                    <select class="form-control select2" id="isLicensed" name="isLicensed" style="width: 100%;">
                                        <option value="True">Active</option>
                                        <option value="False">Inactive</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                @Html.LabelFor(model => model.licenseNumber, htmlAttributes: new { @class = "control-label" })
                                @Html.ValidationMessageFor(model => model.licenseNumber, "", new { @class = "text-danger" })
                                <div class="input-group">
                                    <div class="input-group-addon">
                                        <i class="fa fa-id-card-o"></i>
                                    </div>
                                    @Html.EditorFor(model => model.licenseNumber, new { htmlAttributes = new { @class = "form-control required", @id = "NumLicence" } })
                                </div>
                                <br />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <div class="d-flex flex-row-reverse">
                        <div class="p-2">
                            <button id="add_company" name="add_dictionary" type="submit" value="Create" class="btn btn-info waves-effect waves-light btn-block">
                                Add
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script>
    $("#isLicensed").on("change", function () {
        var Activate = $('#isLicensed').val();
        if (Activate === "True") {
            $("#NumLicence").prop("disabled", false);
        } else {
            $("#NumLicence").prop("disabled", true);
        }
    });
</script>