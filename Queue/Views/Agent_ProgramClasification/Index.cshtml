@model IEnumerable<Queue.Models.Agent_ProgramClasification>
@using Queue.Models
@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Clasificación de programas";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var table = TableComponent.From(Model ?? Enumerable.Empty<Agent_ProgramClasification>(),
        new TableColumn<Agent_ProgramClasification> { Title = "Programa", Cell = program => TableCell.Text(program.name) },
        new TableColumn<Agent_ProgramClasification> { Title = "Clasificación", Cell = program => TableCell.Text(program.clasification == 1 ? "Productiva" : program.clasification == 2 ? "Improductiva" : program.clasification == 3 ? "Neutral" : "Sin clasificar") },
        new TableColumn<Agent_ProgramClasification> { Title = "Grupos", Cell = program => TableCell.Link("Administrar grupos", Url.Action("AsignarGrupo", "Agent_ProgramClasification", new { id = program.idprogramclasification })) },
        new TableColumn<Agent_ProgramClasification> { Title = "Acciones", Cell = program => TableCell.Link("Editar", Url.Action("Edit", "Agent_ProgramClasification", new { id = program.idprogramclasification })) });
    table.Title = "Clasificación de programas";
    table.Description = "Define cómo participa cada programa en la actividad del equipo.";
    table.CreateUrl = Url.Action("Create", "Agent_ProgramClasification");
    table.CreateLabel = "Nueva clasificación";
    table.EmptyMessage = "Todavía no hay programas clasificados.";
}
@Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)

