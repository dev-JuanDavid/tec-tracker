@model Queue.Models.Agent_ProgramClasification
@using Queue.Models.Components
@{
    ViewBag.Title = "Eliminar clasificación";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var form = new FormComponent {
        Title = "Eliminar clasificación", Description = "Confirma la eliminación de la clasificación de «" + Model.name + "».",
        ActionUrl = Url.Action("Delete", "Agent_ProgramClasification"), CancelUrl = Url.Action("Index", "Agent_ProgramClasification"), SubmitLabel = "Eliminar clasificación",
        Inputs = new System.Collections.Generic.List<IFormInput> { new HiddenInput { Name = "id", Value = Model.idprogramclasification } }
    };
}
@Html.Partial("~/Views/Shared/Components/Forms/_Form.cshtml", form, new ViewDataDictionary(ViewData))

