                        </p>
                    </div>
                </div>
            </div>

        </div>*@
    </div>

        <div class="form-actions">
            <div class="d-flex flex-row-reverse">
                <div class="p-2">
                    <button id="edit" name="add_dictionary" type="submit" value="Create" class="btn btn-warning waves-effect waves-light btn-block">
                        Edit
                    </button>
                </div>
            </div>
        </div>

        <script src="~/Scripts/jquery-3.4.1.min.js"></script>
        <script>
        $(document).ready(function () {
            var status = '@ViewBag.status';
            if (status == "False") {
                $("#string_status").val("Inactive");
            }
        });
        </script>
        }
