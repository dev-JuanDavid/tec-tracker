@model IEnumerable<Queue.Models.Agent_Employee>
@using Queue.Models
@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Empleados";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var table = TableComponent.From(Model ?? Enumerable.Empty<Agent_Employee>(),
        new TableColumn<Agent_Employee> { Title = "Identificación", Cell = employee => TableCell.Text(employee.Identificacion) },
        new TableColumn<Agent_Employee> { Title = "Nombre", Cell = employee => TableCell.Text(employee.Nombre) },
        new TableColumn<Agent_Employee> { Title = "Correo electrónico", Cell = employee => TableCell.Text(employee.Email) },
        new TableColumn<Agent_Employee> { Title = "Usuario", Cell = employee => TableCell.Text(employee.Usuario) },
        new TableColumn<Agent_Employee> { Title = "Estado", Cell = employee => TableCell.Badge(employee.status ? "Activo" : "Inactivo", employee.status) },
        new TableColumn<Agent_Employee> { Title = "Editar", Cell = employee => TableCell.Link("Editar", Url.Action("Edit", "Agent_Employee", new { id = employee.idEmployee })) },
        new TableColumn<Agent_Employee> { Title = "Eliminar", Cell = employee => TableCell.Link("Eliminar", Url.Action("Delete", "Agent_Employee", new { id = employee.idEmployee })) });
    table.Title = "Empleados";
    table.Description = "Consulta y administra los empleados de tu empresa.";
    table.CreateUrl = Url.Action("Create", "Agent_Employee");
    table.CreateLabel = "Nuevo empleado";
    table.Actions.Add(TableCell.Link("Cargar empleados", Url.Action("uploaduser", "Agent_Employee")));
    table.EmptyMessage = "Todavía no hay empleados asociados a esta empresa.";
}
@Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)

