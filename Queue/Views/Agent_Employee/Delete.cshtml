@model Queue.Models.Agent_Employee
@using Queue.Models.Components
@{
    ViewBag.Title = "Eliminar empleado";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var detail = new DetailComponent {
        Title = "Datos del empleado",
        Fields = new System.Collections.Generic.List<DetailField> {
            new DetailField { Label = "Nombre", Value = Model.Nombre },
            new DetailField { Label = "Identificación", Value = Model.Identificacion },
            new DetailField { Label = "Correo electrónico", Value = Model.Email },
            new DetailField { Label = "Usuario", Value = Model.Usuario }
        }
    };
    var form = new FormComponent {
        Id = "delete-employee-form", Title = "Confirmar eliminación", Description = "Se eliminará el registro del empleado. Esta acción no se puede deshacer.",
        ActionUrl = Url.Action("Delete", "Agent_Employee"), CancelUrl = Url.Action("Index", "Agent_Employee"),
        SubmitLabel = "Eliminar empleado", Inputs = new System.Collections.Generic.List<IFormInput> { new HiddenInput { Name = "id", Value = Model.idEmployee } }
    };
}
<div class="space-y-6">
    @Html.Partial("~/Views/Shared/Components/Details/_Details.cshtml", detail)
    @Html.Partial("~/Views/Shared/Components/Forms/_Form.cshtml", form, new ViewDataDictionary(ViewData))
</div>

