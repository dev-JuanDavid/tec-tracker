@model Queue.Models.Agent_Employee
@{
    Layout = null; // 👈 no usamos _Layout porque será cargado en modal
}

@using (Html.BeginForm("Create", "Agent_Employee", FormMethod.Post, new { id = "frm_createEmployee" }))
{
    @Html.AntiForgeryToken()

    <h2 class="text-xl font-semibold text-gray-800 mb-4">➕ Crear Empleado</h2>

    <div class="grid grid-cols-2 gap-4">
        <div>
            @Html.LabelFor(m => m.Nombre, new { @class = "block font-medium text-gray-700" })
            @Html.TextBoxFor(m => m.Nombre, new { @class = "w-full border rounded-lg p-2" })
            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-red-500 text-sm" })
        </div>

        <div>
            @Html.LabelFor(m => m.Identificacion, new { @class = "block font-medium text-gray-700" })
            @Html.TextBoxFor(m => m.Identificacion, new { @class = "w-full border rounded-lg p-2" })
            @Html.ValidationMessageFor(m => m.Identificacion, "", new { @class = "text-red-500 text-sm" })
        </div>

        <div>
            @Html.LabelFor(m => m.Email, new { @class = "block font-medium text-gray-700" })
            @Html.TextBoxFor(m => m.Email, new { @class = "w-full border rounded-lg p-2", @type = "email" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-red-500 text-sm" })
        </div>

        <div>
            @Html.LabelFor(m => m.Usuario, new { @class = "block font-medium text-gray-700" })
            @Html.TextBoxFor(m => m.Usuario, new { @class = "w-full border rounded-lg p-2" })
            @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "text-red-500 text-sm" })
        </div>

        <div>
            @Html.LabelFor(m => m.Cargo, new { @class = "block font-medium text-gray-700" })
            @Html.DropDownList("Cargo", new SelectList(ViewBag.Jobs, "idJob", "Cargo"),
                "Seleccione un cargo", new { @class = "w-full border rounded-lg p-2" })
            @Html.ValidationMessageFor(m => m.Cargo, "", new { @class = "text-red-500 text-sm" })
        </div>

        <div>
            @Html.LabelFor(m => m.Id_GroupHorary, new { @class = "block font-medium text-gray-700" })
            @Html.DropDownList("Id_GroupHorary", new SelectList(ViewBag.Horarys, "Id_GroupHorary", "NameGroup"),
                "Seleccione un horario", new { @class = "w-full border rounded-lg p-2" })
            @Html.ValidationMessageFor(m => m.Id_GroupHorary, "", new { @class = "text-red-500 text-sm" })
        </div>
    </div>

    <div class="mt-6 flex justify-end">
        <button type="submit"
                class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg shadow">
            Guardar
        </button>
        <button type="button" onclick="closeCreateModal()"
                class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition">
            ✖ Cancelar
        </button>
    </div>
}
