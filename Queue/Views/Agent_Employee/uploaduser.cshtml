@model IEnumerable<Queue.ViewModels.Agent_Employee_ViewModel>
@using Queue.Models.Components
@using Queue.ViewModels
@using System.Linq
@{
    ViewBag.Title = "Cargar empleados";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var separator = System.Configuration.ConfigurationManager.AppSettings["CSV_Separator"] ?? ",";
    var form = new FormComponent {
        Id = "employee-upload-form", Title = "Importar empleados",
        Description = "Selecciona un archivo CSV para agregar varios empleados en una sola carga.",
        ActionUrl = Url.Action("uploaduser", "Agent_Employee"), CancelUrl = Url.Action("Index", "Agent_Employee"),
        SubmitLabel = "Importar archivo", UploadFiles = true, SingleColumn = true,
        Inputs = new System.Collections.Generic.List<IFormInput> {
            new FileInput { Name = "file", Label = "Archivo de empleados", Required = true, Accept = ".csv,text/csv", Help = "Selecciona un archivo .csv con siete columnas y sin fila de encabezados." }
        }
    };
    var rejected = (Model ?? Enumerable.Empty<Agent_Employee_ViewModel>()).ToList();
    var table = TableComponent.From(rejected,
        new TableColumn<Agent_Employee_ViewModel> { Title = "Identificación", Cell = row => TableCell.Text(row.Identificacion) },
        new TableColumn<Agent_Employee_ViewModel> { Title = "Nombre", Cell = row => TableCell.Text(row.Nombre) },
        new TableColumn<Agent_Employee_ViewModel> { Title = "Correo electrónico", Cell = row => TableCell.Text(row.Email) },
        new TableColumn<Agent_Employee_ViewModel> { Title = "Cargo", Cell = row => TableCell.Text(row.Cargo) },
        new TableColumn<Agent_Employee_ViewModel> { Title = "Usuario", Cell = row => TableCell.Text(row.Usuario) },
        new TableColumn<Agent_Employee_ViewModel> { Title = "Motivo", Cell = row => TableCell.Text(row.posibleerror) });
    table.Title = "Registros que requieren revisión";
    table.Description = "Corrige estos registros antes de volver a cargarlos.";
    var example = string.Join(separator, new[] { "Ana Pérez", "Calle 10", "3001234567", "ana@ejemplo.com", "12345678", "Analista", "ana.perez" });
}
<div class="space-y-6">
    <header><p class="text-xs font-semibold uppercase tracking-widest text-[#6d5fb9]">Importación del equipo</p><h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-800">Cargar empleados</h1><p class="mt-2 text-sm text-slate-500">Prepara tu archivo, impórtalo y revisa los registros que necesiten correcciones.</p></header>
    <div class="grid grid-cols-1 items-start gap-6 xl:grid-cols-2">
        @Html.Partial("~/Views/Shared/Components/Forms/_Form.cshtml", form, new ViewDataDictionary(ViewData))
        <aside class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm sm:p-8">
            <h2 class="text-lg font-semibold text-slate-800">Cómo preparar el archivo</h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">Incluye un empleado por línea, sin encabezados. Utiliza el separador configurado: <code class="rounded bg-[#6d5fb9]/10 px-2 py-1 text-[#6d5fb9]">@separator</code>.</p>
            <ol class="mt-5 grid list-inside list-decimal grid-cols-1 gap-3 text-sm text-slate-700 sm:grid-cols-2">
                <li>Nombre completo</li><li>Dirección</li><li>Teléfono</li><li>Correo electrónico</li><li>Identificación</li><li>Nombre del cargo</li><li>Usuario</li>
            </ol>
            <div class="mt-6 rounded-xl border border-slate-100 bg-slate-50 p-4">
                <h3 class="text-xs font-semibold text-slate-500">Ejemplo de una línea</h3>
                <code class="mt-3 block break-all text-xs leading-relaxed text-slate-700">@example</code>
            </div>
            <p class="mt-4 text-xs leading-relaxed text-slate-500">El cargo debe existir en la empresa. Evita incluir el separador dentro de los valores: el importador actual divide cada línea en siete campos.</p>
        </aside>
    </div>
    @if (rejected.Count > 0)
    {
        <p class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800" role="status">Hay @rejected.Count registros que requieren revisión. Consulta los motivos en la tabla.</p>
        @Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)
    }
</div>

