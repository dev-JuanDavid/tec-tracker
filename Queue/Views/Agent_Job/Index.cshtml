@model IEnumerable<Queue.Models.Agent_Job>
@using Queue.Models
@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Cargos";
    ViewBag.NavTitle = "Cargos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var table = TableComponent.From(Model ?? Enumerable.Empty<Agent_Job>(),
        new TableColumn<Agent_Job> { Title = "Cargo", Cell = item => TableCell.Text(item.Cargo) },
        new TableColumn<Agent_Job> { Title = "Descripción", Cell = item => TableCell.Text(item.Descripcion) },
        new TableColumn<Agent_Job> { Title = "Estado", Cell = item => TableCell.Badge(item.status ? "Activo" : "Inactivo", item.status) },
        new TableColumn<Agent_Job> { Title = "Acciones", Cell = item => TableCell.Link("Editar", Url.Action("Edit", "Agent_Job", new { id = item.idJob })) });
    table.Title = "Cargos";
    table.Description = "Organiza los cargos y consulta su estado en un solo lugar.";
    table.CreateUrl = Url.Action("Create", "Agent_Job");
    table.CreateLabel = "Nuevo cargo";
    table.EmptyMessage = "Crea tu primer cargo para comenzar a organizar tu equipo.";
}
@Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)

