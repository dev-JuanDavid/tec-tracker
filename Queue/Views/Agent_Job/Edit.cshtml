@model Queue.Models.Agent_Job

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("Edit", "Agent_Job", FormMethod.Post, new { id = "frm_register" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.idJob)

    <div class="max-w-5xl mx-auto p-6">
        <div class="bg-white rounded-2xl shadow-lg p-6">
            <!-- Header -->
            <div class="flex items-center justify-between border-b pb-4 mb-6">
                <h4 class="text-xl font-semibold text-gray-800">Edit Job and Schedule</h4>
                <a href="@Url.Action("Index", "Agent_Job")"
                   class="inline-flex items-center px-4 py-2 bg-blue-500 text-white text-sm font-medium rounded-lg shadow hover:bg-blue-600 transition">
                    ← Atras
                </a>
            </div>

            <!-- Form -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Cargo -->
                <div>
                    @Html.LabelFor(model => model.Cargo, htmlAttributes: new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                    @Html.ValidationMessageFor(model => model.Cargo, "", new { @class = "text-red-500 text-xs" })
                    @Html.EditorFor(model => model.Cargo, new { htmlAttributes = new { @class = "w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } })
                </div>

                <!-- Descripcion -->
                <div>
                    @Html.LabelFor(model => model.Descripcion, htmlAttributes: new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                    @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-red-500 text-xs" })
                    @Html.EditorFor(model => model.Descripcion, new { htmlAttributes = new { @class = "w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } })
                </div>

                <!-- Status -->
                <div>
                    @Html.LabelFor(model => model.status, htmlAttributes: new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                    @Html.ValidationMessageFor(model => model.status, "", new { @class = "text-red-500 text-xs" })
                    <select class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            id="string_status" name="string_status">
                        <option id="1">Active</option>
                        <option id="0">Inactive</option>
                    </select>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex justify-end mt-6">
                <button id="edit" name="add_dictionary" type="submit" value="Create"
                        class="px-6 py-2 bg-yellow-500 text-white rounded-lg shadow hover:bg-yellow-600 transition">
                    Edit
                </button>
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script>
        $(document).ready(function () {
            var status = '@ViewBag.status';
            if (status == "False") {
                $("#string_status").val("Inactive");
            }
        });
    </script>
}
