@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Reporte de actividades";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var groups = (ViewBag.idgruoup as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>()).Select(g => new SelectListItem { Value = g.Value, Text = g.Value == Guid.Empty.ToString() ? "Todos los grupos" : g.Text }).ToList();
    var form = new FormComponent {
        Id = "activity-report-form", Title = "Consultar actividad", Description = "Selecciona una fecha, un intervalo y un grupo para explorar la jornada.",
        ActionUrl = Url.Action("Index", "ReportGantt"), SubmitLabel = "Consultar reporte",
        Inputs = new System.Collections.Generic.List<IFormInput> {
            new DateInput { Name = "DateFrom", Label = "Fecha de actividad", Value = DateTime.Today, Required = true },
            new SelectInput { Name = "ddlPeriods", Label = "Intervalo", Value = "5", EmptyLabel = null, Options = new[] {
                new SelectListItem { Value = "5", Text = "5 minutos" }, new SelectListItem { Value = "10", Text = "10 minutos" },
                new SelectListItem { Value = "30", Text = "30 minutos" }, new SelectListItem { Value = "45", Text = "45 minutos" },
                new SelectListItem { Value = "60", Text = "Una hora" }, new SelectListItem { Value = "120", Text = "Dos horas" } } },
            new SelectInput { Name = "idgruoup", Label = "Grupo de empleados", Options = groups, Value = Guid.Empty, EmptyLabel = null }
        }
    };
}
<div class="space-y-6">
    <header><p class="text-xs font-semibold uppercase tracking-widest text-[#6d5fb9]">Actividad del equipo</p><h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-800">Reporte de actividades</h1><p class="mt-2 text-sm text-slate-500">Explora las aplicaciones utilizadas y su duración a lo largo del día.</p></header>
    @Html.Partial("~/Views/Shared/Components/Forms/_Form.cshtml", form)
    <section class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-800">Seleccionar empleado</h2>
        <p class="mt-1 text-sm text-slate-500">Consulta el reporte y selecciona un empleado para mostrar su actividad.</p>
        <div id="userList" class="mt-5 flex max-h-40 flex-wrap gap-2 overflow-y-auto" aria-label="Empleados del reporte"></div>
        <div class="mt-6 flex flex-wrap gap-4 border-t border-slate-100 pt-5 text-xs font-medium text-slate-600">
            <span class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-[#55cbcd]" aria-hidden="true"></span>Productiva</span>
            <span class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-[#ff968a]" aria-hidden="true"></span>Improductiva</span>
            <span class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-[#8FA2AD]" aria-hidden="true"></span>Neutral</span>
            <span class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-[#445a67]" aria-hidden="true"></span>Inactiva</span>
        </div>
    </section>
    <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm">
        <p id="chartEmptyMessage" class="px-4 py-3 text-sm text-slate-500" role="status">Selecciona un empleado para ver su línea de tiempo.</p>
        <p id="divWait" class="hidden px-4 py-3 text-sm text-[#6d5fb9]" role="status">Cargando actividades…</p>
        <p id="sin_Data" class="hidden px-4 py-3 text-sm text-slate-500" role="status">No hay actividades disponibles.</p>
        <div id="chartContainer" class="max-h-[550px] overflow-auto">
            @Html.Partial("~/Views/Shared/Components/Charts/_Chart.cshtml", new ChartComponent { Id = "chart", Title = "Línea de tiempo", Description = "Aplicaciones y períodos de actividad del empleado seleccionado." })
        </div>
    </div>
</div>
@section Scripts {
<script src="@Url.Content("~/Scripts/jquery-3.4.1.min.js")"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/apexcharts@5.3.6/dist/apexcharts.min.js"></script>
<script>
    const PER_ROW_PX = 30;
    document.querySelector("#activity-report-form button[type=submit]").id = "btnProcesarConsulta";
    var globalData = [];
    var chart = null;

    $(document).ready(function () {


        // Bind del botón Buscar
        $("#activity-report-form").off("submit").on("submit", function (e) {
            e.preventDefault();
            ReportGantt();
        });

        // Opcional: si quieres precargar datos al abrir la página, descomenta:
        ReportGantt();
    });

    function ReportGantt() {
        var params = {
            dateFrom: $("#DateFrom").val(),
            dateTo: $("#DateFrom").val(),
            periods: $("#ddlPeriods").val(),
            user: [],
            idgruoup: $("#idgruoup").val()
        };

        $("#divWait").removeClass("hidden");
        $("#sin_Data").addClass("hidden");
        $("#chartEmptyMessage").addClass("hidden");
        if (chart) { chart.destroy(); chart = null; }
        $("#chart").empty();
        $("#btnProcesarConsulta").prop("disabled", true);

        $.ajax({
            type: "POST",
            url: '@Url.Action("NewChart", "ReportGantt")',
            data: JSON.stringify(params),
            contentType: "application/json; charset=utf-8",
            success: function (data) {

                if (!data || !data.length) {
                    $("#sin_Data").removeClass("hidden");
                    globalData = [];
                    renderUserList([]);
                    renderFilteredChart([]);
                    $("#chartEmptyMessage").text("No hay actividades para los filtros seleccionados.");
                    return;
                }

                globalData = data;
                drawChart(data);
            },
            error: function (err) {
                console.error("Error al obtener datos:", err);
                $("#sin_Data").removeClass("hidden");
                globalData = [];
                renderUserList([]);
                renderFilteredChart([]);
                $("#chartEmptyMessage").text("No se pudo cargar el reporte. Intenta consultar nuevamente.");
            },
            complete: function () {
                $("#divWait").addClass("hidden");
                $("#btnProcesarConsulta").prop("disabled", false);
            }
        });
    }

    function drawChart(data) {
        $("#chartEmptyMessage").text("Selecciona un empleado para ver su línea de tiempo.");
        renderUserList(data);
        renderFilteredChart([]);
    }

    function renderUserList(data) {
        var $container = $("#userList");
        $container.empty();

        for (var i = 0; i < data.length; i++) {
            var userData = data[i];
            var displayName = userData.UserName || userData.userName || ("Usuario " + (i + 1));
            var userId = "userChip_" + i;

            // inner HTML del chip (SVG check + label)
            var inner = '<svg class="chip-check hidden w-4 h-4" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M20 6L9 17L4 12" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
                        '<span class="chip-label">' + escapeHtml(displayName) + '</span>';

            var $btn = $("<button>")
                .attr("type", "button")
                .attr("aria-pressed", "false")
                .attr("id", userId)
                .attr("data-user", displayName)
                .addClass("userChip flex items-center gap-2 px-3 py-1 rounded-full text-sm font-medium bg-slate-100 text-slate-700 hover:brightness-95 transition")
                .html(inner);

            $container.append($btn);
        }

        // Click handler: selección única (toggle si clicas mismo)
        $(".userChip").off("click").on("click", function () {
            var $this = $(this);
            var wasActive = $this.hasClass("active");

            // Resetear todos
            $(".userChip").attr("aria-pressed", "false")
                .removeClass("active bg-[#6d5fb9] text-white")
                .addClass("bg-slate-100 text-slate-700")
                .find(".chip-check").addClass("hidden");

            if (!wasActive) {
                // Activar este
                $this.attr("aria-pressed", "true").addClass("active bg-[#6d5fb9] text-white")
                     .removeClass("bg-slate-100 text-slate-700")
                     .find(".chip-check").removeClass("hidden");

                var sel = $this.attr("data-user");
                filterChartByUserName(sel);
            } else {
                // estaba activo y se desactiva -> limpiar gráfica
                renderFilteredChart([]);
            }
        });
    }

    function filterChartByUserName(userName) {
        if (!globalData || !globalData.length) {
            renderFilteredChart([]);
            return;
        }

        // buscar coincidencia exacta (intenta varios campos)
        var filtered = globalData.filter(function (u) {
            return (u.UserName && u.UserName === userName) ||
                   (u.userName && u.userName === userName) ||
                   false;
        });

        if (!filtered.length) {
            // intentamos contains por si hay sufijos/prefijos
            filtered = globalData.filter(function (u) {
                var n = (u.UserName || u.userName || "").toString();
                return n.indexOf(userName) >= 0;
            });
        }

        renderFilteredChart(filtered);
    }

    function renderFilteredChart(data) {
        $("#sin_Data").addClass("hidden");

        if (!data || !data.length) {
            if (chart) {
                try { chart.destroy(); } catch (e) { console.warn(e); }
                chart = null;
            }
            $("#chart").empty();
            $("#chartEmptyMessage").removeClass("hidden");
            return;
        }

        $("#chartEmptyMessage").addClass("hidden");

        var seriesData = [];
        var totalRows = 0;

        for (var i = 0; i < data.length; i++) {
            var userData = data[i];
            var userSeries = { name: userData.UserName || userData.userName, data: [] };

            if (userData.ReportSytems && Array.isArray(userData.ReportSytems)) {
                for (var j = 0; j < userData.ReportSytems.length; j++) {
                    var app = userData.ReportSytems[j];
                    var start = app.FocusTimeT ? new Date(app.FocusTimeT).getTime() : null;
                    var end = app.DateEnd ? new Date(app.DateEnd).getTime() : null;
                    if (start === null || end === null || isNaN(start) || isNaN(end)) continue;

                    var label = String(app.Application || "Sin aplicación").trim();

                    // construir tooltip HTML
                    var tip = '<div class="p-2 bg-white rounded shadow-lg text-sm">' +
                              '<b>Usuario:</b> ' + escapeHtml(userData.UserName || userData.userName) + '<br/>' +
                              '<b>Aplicación:</b> ' + escapeHtml(app.ApplicationT || app.Application || "") + '<br/>' +
                              '<b>Duración:</b> ' + escapeHtml(app.MessageDuration || "") + '<br/>' +
                              (app.URL ? ('<b>URL:</b> ' + escapeHtml(app.URL) + '<br/>') : '') +
                              '<b>Desde:</b> ' + moment(app.FocusTimeT).format('HH:mm:ss') + '<br/>' +
                              '<b>Hasta:</b> ' + moment(app.DateEnd).format('HH:mm:ss') +
                              '</div>';

                    userSeries.data.push({
                        x: label,
                        y: [start, end],
                        fillColor: getColor(app.GetAppsImproClassifyMoreUse),
                        tooltip: { custom: (function(html){ return function(){ return html; }; })(tip) }
                    });

                    totalRows++;
                }
            }

            if (userSeries.data.length) seriesData.push(userSeries);
        }

        if (!seriesData.length) {
            if (chart) { chart.destroy(); chart = null; }
            $("#sin_Data").removeClass("hidden");
            $("#chart").empty();
            return;
        }

        var chartHeight = Math.max(300, totalRows * PER_ROW_PX + 120);

        if (chart) {
            try { chart.destroy(); } catch (e) { console.warn(e); }
            chart = null;
        }


        if (!window.ApexCharts) {
            $("#sin_Data").text("No se pudo cargar la librería de gráficas. Recarga la página para reintentar.").removeClass("hidden");
            return;
        }
        chart = new ApexCharts(document.querySelector("#chart"), {
            chart: { type: 'rangeBar', height: chartHeight, toolbar: { show: false }, fontFamily: 'inherit' },
            plotOptions: {
                bar: {
                    horizontal: true,
                    borderRadius: 6,
                    barHeight: 20
                }
            },
            xaxis: { type: 'datetime', labels: { datetimeUTC: false, format: 'HH:mm' } },
            yaxis: {
                labels: {
                    formatter: function (val) {
                        val = String(val || "");
                        return val.replace("Sin clasificar | ", "");
                    }
                }
            },
            tooltip: {
                custom: function (opts) {
                    try {
                        return opts.w.config.series[opts.seriesIndex].data[opts.dataPointIndex].tooltip.custom();
                    } catch (e) {
                        return "";
                    }
                }
            },
            series: seriesData
        });


        chart.render();
    }

    function getColor(type) {
        switch (String(type)) {
            case "1":
            case "Productivo": return "#55cbcd";
            case "2":
            case "Improductivo": return "#ff968a";
            case "0":
            case "Neutro": return "#8FA2AD";
            case "3":
            case "Inactivo": return "#445a67";
            default: return "#000000";
        }
    }

    function escapeHtml(unsafe) {
        if (unsafe === null || unsafe === undefined) return "";
        return String(unsafe)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }


</script>
}

