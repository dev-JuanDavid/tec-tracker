@model IEnumerable<Queue.Models.License>
@using Queue.Models
@using Queue.Models.Components
@using System.Linq
@{
    ViewBag.Title = "Licencias";
    ViewBag.NavTitle = ViewBag.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    Guid company = ViewBag.idempresa;
    var table = TableComponent.From(Model ?? Enumerable.Empty<License>(),
        new TableColumn<License> { Title = "Vencimiento", Cell = item => TableCell.Text(item.enddate.ToString("dd/MM/yyyy")) },
        new TableColumn<License> { Title = "Estado", Cell = item => TableCell.Badge(item.enddate >= DateTime.Today ? "Vigente" : "Vencida", item.enddate >= DateTime.Today) },
        new TableColumn<License> { Title = "Detalle", Cell = item => TableCell.Link("Ver detalle", Url.Action("Details", new { id = item.IdLicense })) },
        new TableColumn<License> { Title = "Editar", Cell = item => TableCell.Link("Editar", Url.Action("Edit", new { id = item.IdLicense })) },
        new TableColumn<License> { Title = "Eliminar", Cell = item => TableCell.Link("Eliminar", Url.Action("Delete", new { id = item.IdLicense })) });
    table.Title = "Licencias"; table.Description = "Empresa: " + ViewBag.CompanyName + ". Consulta la vigencia y administra las fechas de vencimiento.";
    table.CreateUrl = Url.Action("Create", new { idempresa = company }); table.CreateLabel = "Nueva licencia";
    table.EmptyMessage = "Esta empresa no tiene licencias registradas.";
    table.Actions.Add(TableCell.Link("Volver a empresa", Url.Action("Details", "Agent_Empresa", new { id = company })));
}
@Html.Partial("~/Views/Shared/Components/Tables/_Table.cshtml", table)
