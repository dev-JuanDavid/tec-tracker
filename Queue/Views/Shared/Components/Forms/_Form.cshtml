@model Queue.Models.Components.FormComponent
<section class="mx-auto max-w-4xl overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
    <header class="border-b border-slate-100 px-6 py-6 sm:px-8">
        <div class="mb-3 h-1 w-10 rounded-full bg-[#6d5fb9]" aria-hidden="true"></div>
        <h1 class="text-xl font-semibold tracking-tight text-slate-800">@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="mt-2 text-sm leading-relaxed text-slate-500">@Model.Description</p>
        }
    </header>
    <form id="@Model.Id" action="@Model.ActionUrl" method="@(Model.UseGet ? "get" : "post")" enctype="@(Model.UploadFiles ? "multipart/form-data" : "application/x-www-form-urlencoded")">
        @if (!Model.UseGet) { @Html.AntiForgeryToken() }
        <div class="px-6 pt-6 sm:px-8">
            @Html.ValidationSummary(false, "", new { @class = "text-sm text-rose-600" })
        </div>
        <div class="grid grid-cols-1 gap-6 px-6 py-6 @(Model.SingleColumn ? "" : "sm:grid-cols-2") sm:px-8">
            @foreach (var input in Model.Inputs)
            {
                @Html.Partial("~/Views/Shared/Components/Inputs/_Field.cshtml", input, new ViewDataDictionary(ViewData))
            }
        </div>
        <footer class="flex flex-wrap items-center justify-end gap-3 border-t border-slate-100 bg-slate-50/60 px-6 py-5 sm:px-8">
            @if (!string.IsNullOrWhiteSpace(Model.CancelUrl))
            {
                <a href="@Model.CancelUrl" class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-200">Cancelar</a>
            }
            <button type="submit" class="rounded-xl bg-[#6d5fb9] px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#594b9c] focus:outline-none focus:ring-4 focus:ring-[#6d5fb9]/20">@Model.SubmitLabel</button>
        </footer>
    </form>
</section>
