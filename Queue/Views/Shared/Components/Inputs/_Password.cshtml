@model Queue.Models.Components.PasswordInput
@{ var attributes = Queue.Models.Components.InputAttributes.For(Html, Model); }
@{ attributes["class"] = Convert.ToString(attributes["class"]) + " pr-24"; }
<div class="relative">
    @Html.Password(Model.Name, null, attributes)
    <button type="button" aria-pressed="false" aria-label="Mostrar contraseña" class="absolute inset-y-0 right-3 my-auto h-8 rounded-lg px-2 text-xs font-semibold text-[#6d5fb9] hover:bg-[#6d5fb9]/10 focus:outline-none focus:ring-2 focus:ring-[#6d5fb9]/30" onclick="var field = this.parentElement.querySelector('input'); var show = field.type === 'password'; field.type = show ? 'text' : 'password'; this.textContent = show ? 'Ocultar' : 'Mostrar'; this.setAttribute('aria-pressed', String(show)); this.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');">Mostrar</button>
</div>
