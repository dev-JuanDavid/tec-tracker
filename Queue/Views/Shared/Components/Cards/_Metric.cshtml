@model Queue.Models.Components.MetricComponent
<article class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm">
    <div class="mb-4 h-1 w-8 rounded-full bg-[#6d5fb9]" aria-hidden="true"></div>
    <h2 class="text-sm font-medium text-slate-500">@Model.Label</h2>
    <p class="mt-2 text-3xl font-semibold tracking-tight text-slate-800">@Model.Value</p>
    <p class="mt-2 text-xs text-slate-500">@Model.Description</p>
</article>

